# JavaScript dependencies and local pnpm store
node_modules/
.pnpm-store/
.corepack/

# Rust dependencies cache and build output
.cargo-home/
target/
src-tauri/target/

# Frontend build and test artifacts
dist/
coverage/

# Local environment and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
*.log

# Operating system files
.DS_Store
Thumbs.db

# Sauvegardes locales de la base (volumineuses, non nécessaires au dépôt)
backups/

# Binaire portable produit par tauri build --no-bundle
portable/

# Environnement jetable de la conversion ONNX (scripts/export-demucs-onnx.py).
.venv-export/

# Le modèle de stems est produit par le script d'export et part dans le paquet
# de release. Les deux petits modèles Beat This font au contraire partie du
# moteur d'analyse : un clone frais doit pouvoir analyser sans téléchargement.
src-tauri/resources/models/*
!src-tauri/resources/models/beat_this_small.onnx
!src-tauri/resources/models/mel_spectrogram.onnx

# Journaux d'export ONNX : volumineux, propres à une machine.
scripts/export-logs/

# Les deux documents de travail d'avant la 1.0.
#
# Le journal consigne des décisions au jour le jour; le handoff décrit l'état
# du dépôt pour qui reprend le contexte. Les deux sont précieux à qui développe
# et sans intérêt à qui clone le programme — et le handoff dit franchement ce
# qui reste ouvert, ce qui n'a pas sa place dans une vitrine publique. Ils
# restent sur la machine de l'auteur.
prereleasechangelog.md
handoff.md

# L'audit de performance d'un agent extérieur : même nature que les deux
# précédents. Il décrit un état du dépôt à une date, il est précieux tant qu'on
# travaille dessus, et il n'apprend rien à qui clone le programme. Ce qu'on en a
# retenu est dans le changelog et dans l'architecture.
PERFORMANCE_AUDIT_*.md

# Le texte d'une release, écrit pour être collé dans GitHub puis oublié.
# Le journal versionné, lui, garde la trace de ce que chaque version apporte.
RELEASE-NOTES-*.md

# Traces de l'inspecteur Chromium. Elles ont porté toute la campagne de
# performances de fin juillet et sont précieuses le temps d'une comparaison —
# mais elles pèsent une centaine de mégaoctets pour une poignée de secondes,
# et elles ne valent que pour la machine et le scénario qui les ont produites.
# Ce qu'on en retient appartient au changelog, pas au dépôt.
Trace-*.json.gz

# Bibliothèques ONNX Runtime : récupérées à part, embarquées dans le paquet
# de release, jamais versionnées ici.
src-tauri/resources/*.dll
