{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixCanvas",
  "version": "1.7.1",
  "identifier": "ca.mixcanvas.app",
  "build": {
    "beforeDevCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/pnpm.ps1 dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/pnpm.ps1 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MixCanvas",
        "width": 1280,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/models/*.onnx",
      "resources/*.dll"
    ],
    "shortDescription": "A focused, timeline-based DJ mix editor",
    "longDescription": "MixCanvas is an open source DJ mix editor built around a light, precise musical timeline."
  }
}
